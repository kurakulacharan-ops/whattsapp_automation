JWT_SECRET_KEY=FxEI+Ap6mqjapJOUu/QPgnOgNOBy6acWI9ZfUQNmkYmjQIeCEDyWe1Djch/4Siu3
CORS_ORIGINS=https://attendance.example.com

# SQL Server: create a dedicated application database before startup.
DB_BACKEND=mssql
MSSQL_SERVER=183.177.126.114
MSSQL_DATABASE=attendance
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUSTED_CONNECTION=false
MSSQL_USERNAME=fsadbuser
MSSQL_PASSWORD=FsaBdUser@567
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false

# Redis Streams
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_MAXLEN=100000
WORKER_CONSUMER_NAME=attendance-worker-1
NOTIFICATION_CONSUMER_NAME=notification-worker-1
WORKER_BATCH_SIZE=5
WORKER_BLOCK_MS=5000
WORKER_MAX_RETRIES=5
WORKER_RETRY_DELAY_SECONDS=2
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_DELAY_SECONDS=3

# OCR
# Example Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Duplicate / reuse detection
DUPLICATE_HASH_HAMMING_THRESHOLD=6
NORMALIZED_DUPLICATE_HASH_HAMMING_THRESHOLD=8

# Passive image-quality/liveness risk guard
LIVENESS_ENABLED=true
LIVENESS_MIN_FACE_RATIO=0.07
LIVENESS_MIN_SHARPNESS=35
